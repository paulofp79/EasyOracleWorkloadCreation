# PDB Swingbench Orchestrator service settings (read by systemd; no shell expansion: write values out).
# After a change: systemctl restart pdb-orchestrator

# Bind address and port. 127.0.0.1 = SSH tunnel only, no login.
# 0.0.0.0 = direct access: login (python -m app set-password) and HTTPS are switched on.
ORCH_HOST=@HOST@
ORCH_PORT=@PORT@

# Your own certificate instead of the self-signed one (PEM files readable by @USER@):
#ORCH_TLS_CERT=/etc/pki/tls/certs/orchestrator.pem
#ORCH_TLS_KEY=/etc/pki/tls/private/orchestrator.key
# Behind a reverse proxy that terminates HTTPS:
#ORCH_TLS=off

# Database (profiles, run history, logins); default ~/.pdb-orchestrator/orchestrator.db of @USER@
#ORCH_DB=/u01/pdb-orchestrator/orchestrator.db

# Tools: sqlplus must be on this PATH (Instant Client or $ORACLE_HOME/bin).
PATH=@PATH@
@LD_LIBRARY_PATH@
# Local CDB mode only (sqlplus / as sysdba on a database node):
@ORACLE_HOME@
@ORACLE_SID@
