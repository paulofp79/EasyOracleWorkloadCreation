#!/usr/bin/env python3
"""Simulation control: simctl reset | simctl show"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _simlib as sim  # noqa: E402


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "show"
    if cmd == "reset":
        sim.reset_state()
        print("Simulation state reset:", sim.state_path())
    elif cmd == "show":
        with sim.locked_state() as st:
            print(json.dumps({"state": sim.state_path(), "pdbs": len(st["pdbs"])}, indent=1))
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
