#!/usr/bin/env python3
"""Simulated SQL*Plus. Understands only the statements the orchestrator sends.

  sqlplus -L -s / as sysdba   : env check, inventory, create/open/drop PDB, TDE key, GRANT DBA TO soe
  sqlplus -L -s /nolog        : SOE connection check (CONNECT soe/"pw"@//host:port/service)
"""
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _simlib as sim  # noqa: E402

OK_MSG = {
    "create": "Pluggable database created.",
    "open": "Pluggable database altered.",
    "save": "Pluggable database altered.",
    "drop": "Pluggable database dropped.",
    "container": "Session altered.",
    "register": "System altered.",
    "tde": "keystore altered.",
    "grant": "Grant succeeded.",
    "plsql": "PL/SQL procedure successfully completed.",
}

PATTERNS = [
    ("create", re.compile(r"CREATE\s+PLUGGABLE\s+DATABASE\s+(\w+)", re.I)),
    ("open", re.compile(r"^\s*ALTER\s+PLUGGABLE\s+DATABASE\s+(\w+)\s+OPEN\b", re.I | re.M)),
    ("save", re.compile(r"^\s*ALTER\s+PLUGGABLE\s+DATABASE\s+(\w+)\s+SAVE\s+STATE", re.I | re.M)),
    ("plsql", re.compile(r"^\s*DECLARE\b.*?^/\s*$", re.I | re.M | re.S)),
    ("drop", re.compile(r"^\s*DROP\s+PLUGGABLE\s+DATABASE\s+(\w+)", re.I | re.M)),
    ("container", re.compile(r"^\s*ALTER\s+SESSION\s+SET\s+CONTAINER\s*=\s*(\w+)", re.I | re.M)),
    ("register", re.compile(r"^\s*ALTER\s+SYSTEM\s+REGISTER", re.I | re.M)),
    ("tde", re.compile(r"ADMINISTER\s+KEY\s+MANAGEMENT", re.I)),
    ("grant", re.compile(r"GRANT\s+DBA\s+TO\s+soe\b", re.I)),
    ("env", re.compile(r"'ENV_CHECK\|'")),
    ("token", re.compile(r"'SYSDBA_'\s*\|\|\s*'SESSION_OK'")),
    ("inventory_detail", re.compile(r"'PDB\|'.*?LIKE\s+'([A-Za-z0-9_]+)%'", re.I | re.S)),
    ("inventory", re.compile(r"FROM\s+gv\$pdbs\s+WHERE\s+name\s+LIKE\s+'([A-Za-z0-9_]+)%'", re.I)),
]


class SqlError(Exception):
    def __init__(self, code, text):
        super().__init__(text)
        self.code = code
        self.text = text


def fail(code, text):
    raise SqlError(code, "ORA-%05d: %s" % (code, text))


def n_instances():
    return len(sim.SCENARIO["cdb"].get("instances", ["inst1"]))


def handle(kind, m, ctx):
    if kind == "token":
        sim.out("C", "-----------------", "SYSDBA_SESSION_OK")
        return
    if kind == "env":
        cdb = sim.SCENARIO["cdb"]
        sim.out("ENV_CHECK|%s|%s|%d|YES|CDB$ROOT|%s" % (
            cdb["name"], cdb["version"], n_instances(), cdb.get("cluster_database", "FALSE")))
        return
    if kind == "inventory":
        prefix = m.group(1).upper()
        with sim.locked_state() as st:
            for name in sorted(st["pdbs"]):
                if name.startswith(prefix):
                    p = st["pdbs"][name]
                    rw = sum(1 for o in p["open"] if o == "READ WRITE")
                    sim.out("%s|%s|%d" % (name, p["con_uid"], rw))
        return
    if kind == "inventory_detail":
        prefix = m.group(1).upper()
        instances = sim.SCENARIO["cdb"].get("instances", ["inst1"])
        with sim.locked_state() as st:
            for name in sorted(st["pdbs"]):
                if name.startswith(prefix):
                    p = st["pdbs"][name]
                    for i, mode in enumerate(p["open"]):
                        sim.out("PDB|%s|%s|%d|%s|%s|NO" % (name, p["con_uid"], i + 1, mode, instances[i]))
        return
    if kind == "plsql":
        # The drop helper block: close the PDB if it is open anywhere.
        name = re.search(r"name\s*=\s*'(\w+)'", m.group(0))
        if name:
            with sim.locked_state(write=True) as st:
                p = st["pdbs"].get(name.group(1).upper())
                if p:
                    p["open"] = ["MOUNTED"] * n_instances()
        sim.out(OK_MSG["plsql"])
        return

    pdb = m.group(1).upper() if m.groups() else None
    if kind == "create":
        sim.delay("create_pdb")
        if sim.pdb_scenario(pdb, "create") == "fail":
            fail(1119, "error in creating database file '+DATAC1/%s/system01.dbf'" % pdb)
        with sim.locked_state(write=True) as st:
            if pdb in st["pdbs"]:
                fail(65012, "Pluggable database %s already exists." % pdb)
            st["pdbs"][pdb] = {"con_uid": sim.new_con_uid(), "open": ["MOUNTED"] * n_instances(),
                               "soe_loaded": False}
    elif kind == "open":
        sim.delay("open_pdb")
        with sim.locked_state(write=True) as st:
            p = st["pdbs"].get(pdb)
            if not p:
                fail(65011, "Pluggable database %s does not exist." % pdb)
            p["open"] = ["READ WRITE"] * n_instances()
    elif kind == "drop":
        sim.delay("drop_pdb")
        with sim.locked_state(write=True) as st:
            p = st["pdbs"].get(pdb)
            if not p:
                fail(65011, "Pluggable database %s does not exist." % pdb)
            if any(o != "MOUNTED" for o in p["open"]):
                fail(65025, "Pluggable database %s is not closed on all instances." % pdb)
            del st["pdbs"][pdb]
    elif kind == "container":
        with sim.locked_state() as st:
            p = st["pdbs"].get(pdb)
            if not p:
                fail(65011, "Pluggable database %s does not exist." % pdb)
        ctx["container"] = pdb
    elif kind == "tde":
        if not sim.SCENARIO["cdb"].get("wallet", True):
            fail(28365, "wallet is not open")
    elif kind == "grant":
        pdb = ctx.get("container")
        if not pdb:
            fail(1031, "insufficient privileges")
        with sim.locked_state() as st:
            p = st["pdbs"].get(pdb)
            if not p or "READ WRITE" not in p["open"]:
                fail(1109, "database not open")
    sim.out(OK_MSG[kind])


def run_sysdba(sql):
    sysdba = sim.SCENARIO["cdb"].get("sysdba", "ok")
    if sysdba != "ok":
        sim.out("ERROR:", "ORA-01031: insufficient privileges", "",
                "SP2-0751: Unable to connect to Oracle.  Exiting SQL*Plus")
        return 1
    events = []
    for kind, rx in PATTERNS:
        for m in rx.finditer(sql):
            events.append((m.start(), kind, m))
    events.sort(key=lambda e: e[0])
    # A DROP/OPEN inside a PL/SQL block is not a separate statement.
    blocks = [(m.start(), m.end()) for _, k, m in events if k == "plsql"]
    events = [e for e in events
              if e[1] == "plsql" or not any(s < e[0] < t for s, t in blocks)]
    ctx = {}
    sim.delay("sqlplus")
    for _, kind, m in events:
        try:
            handle(kind, m, ctx)
        except SqlError as exc:
            sim.out(exc.text)
            if re.search(r"WHENEVER\s+SQLERROR\s+EXIT\s+SQL\.SQLCODE", sql, re.I):
                return exc.code % 256
            if re.search(r"WHENEVER\s+SQLERROR\s+EXIT\s+FAILURE", sql, re.I):
                return 1
    return 0


def statements_after(sql, pos):
    return [ln for ln in sql[pos:].splitlines() if ln.strip().endswith(";") or ln.strip() == "/"]


def run_nolog(sql):
    sysm = re.search(r'CONNECT\s+sys/"([^"\n]*)"@(\S+)\s+AS\s+SYSDBA[^\n]*\n', sql, re.I)
    if sysm:
        cdb = sim.SCENARIO["cdb"]
        password, target = sysm.group(1), sysm.group(2)
        service = target.rsplit("/", 1)[-1].lower()
        expected_pw = cdb.get("sys_password")
        error = None
        if service != cdb.get("service", "simcdb.example.com").lower():
            error = "ORA-12514: TNS:listener does not currently know of service requested in connect descriptor"
        elif not password or (expected_pw is not None and password != expected_pw):
            error = "ORA-01017: invalid username/password; logon denied"
        if error:
            # Like real SQL*Plus: the script goes on unconnected and the exit code is still 0.
            sim.out("ERROR:", error, "")
            for _ in statements_after(sql, sysm.end()):
                sim.out("SP2-0640: Not connected")
            return 0
        return run_sysdba(sql[sysm.end():])
    m = re.search(r"CONNECT\s+(\w+)/\"[^\"\n]*\"@(\S+)", sql, re.I)
    if not m:
        sim.out("SP2-0640: Not connected")
        return 0
    pdb = sim.pdb_from_connect(m.group(2))
    scen = sim.pdb_scenario(pdb or "", "check") or "ok"
    with sim.locked_state() as st:
        p = st["pdbs"].get(pdb or "")
    if p is None or "READ WRITE" not in p["open"]:
        scen = "ora12514"
    if scen == "hang":
        sim.sim_sleep(3600)
        return 0
    if scen == "ora12514":
        sim.out("ERROR:",
                "ORA-12514: TNS:listener does not currently know of service requested in connect descriptor",
                "", "", "SP2-0640: Not connected")
        return 0  # failed CONNECT does not reliably give a non-zero exit code
    if scen == "ora01017":
        sim.out("ERROR:", "ORA-01017: invalid username/password; logon denied", "", "",
                "SP2-0640: Not connected")
        return 0
    sim.delay("check_ok")
    instances = sim.SCENARIO["cdb"].get("instances", ["inst1"])
    inst = instances[sum(map(ord, pdb)) % len(instances)]
    con = "CDB$ROOT" if scen == "wrong_container" else pdb
    tables = 4 if (p.get("soe_loaded") and scen != "no_schema") else 0
    sim.out("SOE_CHECK_OK|%s|%s|%d" % (con, inst, tables))
    return 0


def main():
    args = sys.argv[1:]
    if "-v" in args or "-V" in args:
        sim.out("", "SQL*Plus: Release 19.0.0.0.0 - Production (simulated)", "Version 19.21.0.0.0", "")
        return 0
    sql = sys.stdin.read()
    if "/nolog" in args:
        return run_nolog(sql)
    if "/" in args and "sysdba" in args:
        return run_sysdba(sql)
    sim.out("SP2-0306: Invalid option.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
